<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    TROCAR MECHANISM — Cylinder-Shell + Sliding Rod
    =================================================
    Provides a rod-in-cylinder (trocar port) mechanism:
      cylinder_link      → fixed outer tube, attaches to iiwa14_link8
      rod_link           → inner sliding shaft (prismatic Z-axis)
    The grasper jaw assembly mounts at the tip of rod_link.

    Joints:
      trocar_mount_joint         : fixed   (iiwa14_link8 → cylinder_link)
      shaft_translation_joint    : prismatic (cylinder_link → rod_link, Z, 0–0.2 m)
      rod_to_grasper_joint       : fixed   (rod_link → grasper_adapter_link)
  -->

  <xacro:macro name="trocar_mechanism" params="parent:='iiwa14_link7' xyz:='0 0 0.05' rpy:='0 0 0'">

    <!-- ── Outer Cylinder (fixed to robot wrist) ─────────────────────── -->
    <joint name="trocar_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child  link="cylinder_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="cylinder_link">
      <!-- Outer tube body -->
      <visual>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry><cylinder radius="0.012" length="0.10"/></geometry>
        <material name="trocar_gray"><color rgba="0.5 0.5 0.55 0.6"/></material>
      </visual>
      <!-- Entry flange ring -->
      <visual>
        <origin xyz="0 0 0.002" rpy="0 0 0"/>
        <geometry><cylinder radius="0.018" length="0.004"/></geometry>
        <material name="trocar_dark"><color rgba="0.3 0.3 0.35 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry><cylinder radius="0.012" length="0.10"/></geometry>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.0002"/>
      </inertial>
    </link>

    <!-- ── Inner Rod (slides along Z inside the cylinder) ────────────── -->
    <joint name="shaft_translation_joint" type="prismatic">
      <parent link="cylinder_link"/>
      <child  link="rod_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="0.0" upper="0.08" effort="100.0" velocity="0.5"/>
      <!-- Reduced damping/friction for better responsiveness -->
      <dynamics damping="5.0" friction="1.0"/>
    </joint>

    <link name="rod_link">
      <!-- The rod shaft visible beyond the cylinder -->
      <visual>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <geometry><cylinder radius="0.005" length="0.12"/></geometry>
        <material name="rod_steel"><color rgba="0.85 0.85 0.88 1"/></material>
      </visual>
      <!-- Colour band at tip for visibility -->
      <visual>
        <origin xyz="0 0 0.122" rpy="0 0 0"/>
        <geometry><cylinder radius="0.007" length="0.005"/></geometry>
        <material name="rod_tip_gold"><color rgba="1.0 0.85 0.0 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <geometry><cylinder radius="0.005" length="0.12"/></geometry>
      </collision>
      <inertial>
        <mass value="0.15"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.00005"/>
      </inertial>
    </link>

    <!-- ── Inner Rod Tip Marker ────────────────────────────────────────── -->
    <!-- The dvrk_grasper macro attaches directly to rod_link via its own   -->
    <!-- grasper_base_joint, so no additional fixed joint is needed here.   -->

  </xacro:macro>

</robot>
